# PostgreSQL Database
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password
POSTGRES_DB=devops_db

# PgAdmin Credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=secure_admin_pass

# Backend Database Connection String (FastAPI будет использовать)
# Важно: 'db' - это имя сервиса в docker-compose, которое автоматически резолвится в IP внутри сети Docker
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Порты для доступа из хостовой системы
FRONTEND_PORT=3000
BACKEND_PORT=8000
PGADMIN_PORT=5050
